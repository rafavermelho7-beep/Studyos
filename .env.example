# LIFE ENGINE — variáveis de ambiente (copie para .env.local; na Vercel, Project → Settings → Environment Variables)
# Nunca commite valores reais.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # ou a chave "anon" legada

# Único usuário autorizado (DEC-027). Outras contas são barradas mesmo com senha válida.
OWNER_EMAIL=voce@exemplo.com

# IA — ao menos uma. Créditos de API são cobrados à parte de Claude Pro / ChatGPT Plus.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Orçamento de IA (R$/mês). O código limita a no máximo 50.
AI_MONTHLY_BUDGET_BRL=50
# Câmbio usado para converter custos (padrão conservador 5.60).
USD_BRL_RATE=5.60
# Opcional: corrigir preços sem deploy de código. Ex.: [{"id":"gpt-5.4-mini","inputPerMTok":0.75,"outputPerMTok":4.5}]
AI_PRICING_OVERRIDES=
