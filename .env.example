# Postgres connection string (Supabase or any Postgres works). Use the
# "direct connection" string from Supabase's Settings -> Database -> URI —
# no region/pooler host needed, just your project ref:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Not used by the app today (custom auth + Prisma direct to Postgres, no
# Supabase Auth/Storage/Realtime client) -- kept for future use. From
# Settings -> API.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
