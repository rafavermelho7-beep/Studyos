# Postgres connection string (Supabase or any Postgres works). Use the
# SESSION POOLER string from Supabase's Settings -> Database -> Connection
# string -> URI ("Session pooler", port 5432) — NOT "Direct connection" and
# NOT "Transaction pooler". Direct connection is IPv6-only on most Supabase
# projects and simply doesn't connect from Vercel/most serverless hosts
# (IPv4-only egress) even though it works fine from a normal dev machine.
# Transaction pooler (port 6543) is also IPv6 by default (needs Supabase's
# paid IPv4 add-on). Session pooler is the one that's IPv4-compatible
# out of the box and works both locally and deployed:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Not used by the app today (custom auth + Prisma direct to Postgres, no
# Supabase Auth/Storage/Realtime client) -- kept for future use. From
# Settings -> API.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
