// StudyOS data model.
//
// Datasource is SQLite for local-first development without external
// dependencies. Every design choice here is Postgres-compatible on purpose
// (UUID-shaped ids as String/cuid, enums, JSON columns via String) so a
// future migration to Supabase/Postgres is a `datasource` swap + migration,
// not a remodel. Authorization is enforced in the service layer (every
// query scoped by userId) since SQLite has no Row Level Security; the same
// scoping rules are documented in src/server/services/README.md so they can
// be re-expressed as Postgres RLS policies later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────
// Hand-rolled credentials auth (bcrypt password hash + opaque DB-backed
// session token in an httpOnly cookie). No OAuth today, so no Account/
// VerificationToken tables — add them back if/when a social provider
// actually ships instead of carrying unused schema for it.

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String

  // API key for the local Anki connector (brief §26) to authenticate as
  // this user without a browser session cookie. Shaped like
  // "sk_live_<apiKeyId>_<secret>": apiKeyId is public and indexed so a
  // sync request can look the user up in O(1); only the bcrypt hash of
  // the secret half is ever stored. Plaintext is shown once, at
  // generation time, never again.
  apiKeyId   String? @unique
  apiKeyHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  subjects      Subject[]
  topics        Topic[]
  tasks         Task[]
  exams         Exam[]
  studyEvents   StudyEvent[]
  studySources  StudySource[]
  reviewStates  ReviewState[]
  reviewLogs    ReviewLog[]
  ankiDeckLinks AnkiDeckLink[]
  onboarding    OnboardingState?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Core study hierarchy: Subject → Topic (self-referential) ─────────────

enum ContentStatus {
  NOVO
  APRENDENDO
  REVISANDO
  DOMINADO
}

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  professor   String?
  semester    String?
  priority    Int      @default(2) // 1 = alta, 2 = média, 3 = baixa
  color       String   @default("#6366f1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
  tasks  Task[]
  exams  Exam[]

  studyEvents  StudyEvent[]
  studySources StudySource[]
  ankiLinks    AnkiDeckLink[]

  @@index([userId])
}

model Topic {
  id           String        @id @default(cuid())
  userId       String
  subjectId    String
  parentId     String?
  name         String
  status       ContentStatus @default(NOVO)
  difficulty   Int           @default(2) // 1 = fácil, 2 = médio, 3 = difícil
  priority     Int           @default(2)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent  Topic?  @relation("TopicToSubtopic", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[] @relation("TopicToSubtopic")

  tasks        Task[]
  studyEvents  StudyEvent[]
  studySources StudySource[]
  examTopics   ExamTopic[]
  reviewState  ReviewState?
  reviewLogs   ReviewLog[]
  ankiLinks    AnkiDeckLink[]

  @@index([userId])
  @@index([subjectId])
  @@index([parentId])
}

// ─── Tasks ──────────────────────────────────────────────────────────────

// "Overdue" is intentionally not a stored state: it's `dueDate < now &&
// status != DONE`, computed at read time in the service layer. Storing it
// would mean either a background job to flip it or stale data the moment
// midnight passes — see the "events/derivation over redundant aggregates"
// principle in CLAUDE.md.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                 String       @id @default(cuid())
  userId             String
  subjectId          String?
  topicId            String?
  title              String
  description        String?
  priority           TaskPriority @default(MEDIUM)
  dueDate            DateTime?
  estimatedMinutes   Int?
  status             TaskStatus   @default(TODO)
  recurrenceRule     String? // RFC5545-like RRULE string, optional
  tags               String? // comma-separated; simple by design
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

// ─── Exams / deadlines ──────────────────────────────────────────────────

model Exam {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  name      String
  date      DateTime
  location  String?
  priority  Int      @default(2)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  ExamTopic[]

  @@index([userId])
  @@index([date])
}

model ExamTopic {
  examId  String
  topicId String

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([examId, topicId])
}

// ─── Study Events: the central, append-only fact table ────────────────────
// Every timed activity (StudyOS session, Pomodoro block, manual Anki/
// SanarFlix log, future integrations) becomes one StudyEvent. Aggregates
// (hours today, streaks, per-subject time) are always derived from this
// table at query time, never stored redundantly, per the "events not
// aggregates" principle.

enum EventSource {
  STUDYOS
  ANKI
  SANARFLIX
  MANUAL
  OTHER
}

enum ActivityType {
  SESSION
  POMODORO
  REVIEW
  READING
  VIDEO
  QUESTIONS
  OTHER
}

model StudyEvent {
  id           String       @id @default(cuid())
  userId       String
  source       EventSource  @default(STUDYOS)
  activityType ActivityType @default(SESSION)
  subjectId    String?
  topicId      String?
  startedAt    DateTime
  endedAt      DateTime?
  durationSec  Int // authoritative duration in seconds; derived from started/ended when both present
  goal         String?
  notes        String?
  metadata     String? // JSON blob for source-specific extras (e.g. Anki card counts)

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startedAt])
  @@index([subjectId])
  @@index([topicId])
  @@index([source])
}

// ─── Spaced repetition (FSRS) ──────────────────────────────────────────────
// One ReviewState per (user, topic) mirrors an FSRS Card. ReviewLog is the
// append-only history each grading produces — required to redraw the
// forgetting curve and to let the scheduler be swapped later without losing
// history.

enum ReviewCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

model ReviewState {
  id            String          @id @default(cuid())
  userId        String
  topicId       String          @unique
  state         ReviewCardState @default(NEW)
  due           DateTime        @default(now())
  stability     Float           @default(0)
  difficulty    Float           @default(0)
  elapsedDays   Float           @default(0)
  scheduledDays Float           @default(0)
  learningSteps Int             @default(0)
  reps          Int             @default(0)
  lapses        Int             @default(0)
  lastReview    DateTime?

  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([due])
}

model ReviewLog {
  id            String          @id @default(cuid())
  userId        String
  topicId       String
  rating        Int // 1=Again 2=Hard 3=Good 4=Easy (FSRS Rating)
  state         ReviewCardState
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Float
  lastElapsedDays Float
  scheduledDays Float
  reviewedAt    DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([reviewedAt])
}

// ─── Study sources (SanarFlix, Anki, PDFs, ...) ────────────────────────────

enum SourceType {
  ANKI
  SANARFLIX
  YOUTUBE
  PDF
  BOOK
  COURSE
  QUESTIONS
  CLASS
  FLASHCARDS
  OTHER
}

model StudySource {
  id            String     @id @default(cuid())
  userId        String
  subjectId     String?
  topicId       String?
  type          SourceType
  title         String
  url           String?
  completed     Boolean    @default(false)
  manualMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
}

// ─── Anki integration (Phase 16) ───────────────────────────────────────────
// Maps an Anki deck name to a Subject/Topic so imported review activity
// (via the local connector talking to AnkiConnect) lands as StudyEvents
// without assuming deck == subject.

model AnkiDeckLink {
  id         String   @id @default(cuid())
  userId     String
  deckName   String
  subjectId  String
  topicId    String?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, deckName])
}

// ─── Onboarding ─────────────────────────────────────────────────────────

model OnboardingState {
  userId      String   @id
  completedAt DateTime?
  skippedAt   DateTime?
  step        Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
