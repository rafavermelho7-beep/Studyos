// StudyOS data model.
//
// Datasource is Postgres on Supabase (migrated from a SQLite local-first
// setup — see git history before this point for the original rationale).
// Authorization is still enforced entirely in the service layer (every
// query scoped by userId, see src/server/services/README.md), NOT via
// Postgres Row Level Security: Prisma connects as the `postgres` role
// (which bypasses RLS regardless, being the table owner) rather than a
// per-end-user authenticated Postgres role, since auth is our own
// session-cookie system, not Supabase Auth's `auth.uid()`. Real RLS would
// need a restricted app role plus `SET LOCAL` of a session variable per
// request — a real infra change, not attempted yet; the service layer's
// userId filters remain the sole authorization boundary for now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────
// Hand-rolled credentials auth (bcrypt password hash + opaque DB-backed
// session token in an httpOnly cookie). No OAuth today, so no Account/
// VerificationToken tables — add them back if/when a social provider
// actually ships instead of carrying unused schema for it.

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String

  // LEGACY (Anki integration removed 2026-09-25, at the user's request):
  // apiKeyId/apiKeyHash and the AnkiDeckLink table are no longer read or
  // written by any code. Kept only because migrations must stay additive
  // while preview deploys share the production database — drop them in a
  // later, standalone migration once no deployed code references them.
  //
  // API key for the local Anki connector (brief §26) to authenticate as
  // this user without a browser session cookie. Shaped like
  // "sk_live_<apiKeyId>_<secret>": apiKeyId is public and indexed so a
  // sync request can look the user up in O(1); only the bcrypt hash of
  // the secret half is ever stored. Plaintext is shown once, at
  // generation time, never again.
  apiKeyId   String? @unique
  apiKeyHash String?

  // Personalization ("Aparência" in Settings). All optional/defaulted so
  // the migration is purely additive — Vercel preview builds apply
  // migrations to the one shared database (see package.json vercel-build).
  // Allowed values live in src/lib/preferences.ts, validated with zod on
  // write; unknown values read back as the defaults.
  monthlyGoalMinutes Int? // total, not per subject; progress derives from StudyEvent
  themeMode          String   @default("system") // system | light | dark
  accentColor        String   @default("indigo")
  homePage           String   @default("dashboard") // which screen "/" and login open
  // Dashboard blocks: explicit order + which are hidden. Kept as two lists
  // (not one "visible, in order" list) so a block added in a later release
  // still shows up for users who already customized their layout.
  dashboardOrder     String[] @default([])
  dashboardHidden    String[] @default([])
  // App background: plain | gradient | photo (photo uses backgroundImage).
  backgroundStyle    String   @default("plain")
  backgroundImageId  String?  @unique
  backgroundImage    Image?   @relation("UserBackground", fields: [backgroundImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  subjects      Subject[]
  topics        Topic[]
  tasks         Task[]
  exams         Exam[]
  studyEvents   StudyEvent[]
  studySources  StudySource[]
  reviewStates  ReviewState[]
  reviewLogs    ReviewLog[]
  ankiDeckLinks AnkiDeckLink[]
  images        Image[]       @relation("ImageOwner")
  onboarding    OnboardingState?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Core study hierarchy: Subject → Topic (self-referential) ─────────────

enum ContentStatus {
  NOVO
  APRENDENDO
  REVISANDO
  DOMINADO
}

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  professor   String?
  semester    String?
  priority    Int      @default(2) // 1 = alta, 2 = média, 3 = baixa
  color       String   @default("#6366f1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One emoji from the curated list in src/lib/subject-emojis.ts (validated
  // on write). Null = show the color dot.
  emoji String?

  // Optional cover photo (Settings-free: set from the subject's own page).
  coverImageId String? @unique
  coverImage   Image?  @relation("SubjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
  tasks  Task[]
  exams  Exam[]

  studyEvents  StudyEvent[]
  studySources StudySource[]
  ankiLinks    AnkiDeckLink[]

  @@index([userId])
}

model Topic {
  id           String        @id @default(cuid())
  userId       String
  subjectId    String
  parentId     String?
  name         String
  status       ContentStatus @default(NOVO)
  difficulty   Int           @default(2) // 1 = fácil, 2 = médio, 3 = difícil
  priority     Int           @default(2)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent  Topic?  @relation("TopicToSubtopic", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[] @relation("TopicToSubtopic")

  tasks        Task[]
  studyEvents  StudyEvent[]
  studySources StudySource[]
  examTopics   ExamTopic[]
  reviewState  ReviewState?
  reviewLogs   ReviewLog[]
  ankiLinks    AnkiDeckLink[]

  @@index([userId])
  @@index([subjectId])
  @@index([parentId])
}

// ─── Tasks ──────────────────────────────────────────────────────────────

// "Overdue" is intentionally not a stored state: it's `dueDate < now &&
// status != DONE`, computed at read time in the service layer. Storing it
// would mean either a background job to flip it or stale data the moment
// midnight passes — see the "events/derivation over redundant aggregates"
// principle in CLAUDE.md.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                 String       @id @default(cuid())
  userId             String
  subjectId          String?
  topicId            String?
  title              String
  description        String?
  priority           TaskPriority @default(MEDIUM)
  dueDate            DateTime?
  estimatedMinutes   Int?
  status             TaskStatus   @default(TODO)
  recurrenceRule     String? // RFC5545-like RRULE string, optional
  tags               String? // comma-separated; simple by design
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

// ─── Exams / deadlines ──────────────────────────────────────────────────

model Exam {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  name      String
  date      DateTime
  location  String?
  priority  Int      @default(2)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  ExamTopic[]

  @@index([userId])
  @@index([date])
}

model ExamTopic {
  examId  String
  topicId String

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([examId, topicId])
}

// ─── Study Events: the central, append-only fact table ────────────────────
// Every timed activity (StudyOS session, Pomodoro block, manual Anki/
// SanarFlix log, future integrations) becomes one StudyEvent. Aggregates
// (hours today, streaks, per-subject time) are always derived from this
// table at query time, never stored redundantly, per the "events not
// aggregates" principle.

enum EventSource {
  STUDYOS
  ANKI
  SANARFLIX
  MANUAL
  OTHER
}

enum ActivityType {
  SESSION
  POMODORO
  REVIEW
  READING
  VIDEO
  QUESTIONS
  OTHER
}

model StudyEvent {
  id           String       @id @default(cuid())
  userId       String
  source       EventSource  @default(STUDYOS)
  activityType ActivityType @default(SESSION)
  subjectId    String?
  topicId      String?
  startedAt    DateTime
  endedAt      DateTime?
  durationSec  Int // authoritative duration in seconds; derived from started/ended when both present
  goal         String?
  notes        String?
  metadata     String? // JSON blob for source-specific extras (e.g. Anki card counts)

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startedAt])
  @@index([subjectId])
  @@index([topicId])
  @@index([source])
}

// ─── Spaced repetition (FSRS) ──────────────────────────────────────────────
// One ReviewState per (user, topic) mirrors an FSRS Card. ReviewLog is the
// append-only history each grading produces — required to redraw the
// forgetting curve and to let the scheduler be swapped later without losing
// history.

enum ReviewCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

model ReviewState {
  id            String          @id @default(cuid())
  userId        String
  topicId       String          @unique
  state         ReviewCardState @default(NEW)
  due           DateTime        @default(now())
  stability     Float           @default(0)
  difficulty    Float           @default(0)
  elapsedDays   Float           @default(0)
  scheduledDays Float           @default(0)
  learningSteps Int             @default(0)
  reps          Int             @default(0)
  lapses        Int             @default(0)
  lastReview    DateTime?

  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([due])
}

model ReviewLog {
  id            String          @id @default(cuid())
  userId        String
  topicId       String
  rating        Int // 1=Again 2=Hard 3=Good 4=Easy (FSRS Rating)
  state         ReviewCardState
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Float
  lastElapsedDays Float
  scheduledDays Float
  reviewedAt    DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([reviewedAt])
}

// ─── Study sources (SanarFlix, Anki, PDFs, ...) ────────────────────────────

enum SourceType {
  ANKI
  SANARFLIX
  YOUTUBE
  PDF
  BOOK
  COURSE
  QUESTIONS
  CLASS
  FLASHCARDS
  OTHER
}

model StudySource {
  id            String     @id @default(cuid())
  userId        String
  subjectId     String?
  topicId       String?
  type          SourceType
  title         String
  url           String?
  completed     Boolean    @default(false)
  manualMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
}

// ─── Anki integration (Phase 16) ───────────────────────────────────────────
// Maps an Anki deck name to a Subject/Topic so imported review activity
// (via the local connector talking to AnkiConnect) lands as StudyEvents
// without assuming deck == subject.

model AnkiDeckLink {
  id         String   @id @default(cuid())
  userId     String
  deckName   String
  subjectId  String
  topicId    String?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, deckName])
}

// ─── Onboarding ─────────────────────────────────────────────────────────

model OnboardingState {
  userId      String   @id
  completedAt DateTime?
  skippedAt   DateTime?
  step        Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Images (subject covers, app background) ─────────────────────────────
// Stored in Postgres, not Supabase Storage, on purpose: at personal scale
// (a handful of ~200 KB covers + one background, compressed client-side
// before upload) it fits comfortably, authorization stays the same userId
// filter as everything else (served only through /api/images/[id] after a
// session check — no public bucket, no signed URLs), and it's testable
// end-to-end without Storage credentials. Revisit if this ever becomes
// multi-user at scale. `data` is never selected except by that route.
model Image {
  id          String   @id @default(cuid())
  userId      String
  contentType String // sniffed from the bytes on upload, never trusted from the client
  byteSize    Int
  data        Bytes
  createdAt   DateTime @default(now())

  user             User     @relation("ImageOwner", fields: [userId], references: [id], onDelete: Cascade)
  subjectCover     Subject? @relation("SubjectCover")
  userBackgroundOf User?    @relation("UserBackground")

  @@index([userId])
}
